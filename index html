        function formatCurrency(val) {
            return new Intl.NumberFormat('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(val);
        }

        function triggerToast(text, duration = 3000) {
            const toast = document.getElementById('toast-msg');
            const toastText = document.getElementById('toast-text');
            if (!toast || !toastText) return;

            toastText.innerText = text;
            toast.classList.remove('hidden');
            toast.classList.add('animate-bounce');

            setTimeout(() => {
                toast.classList.remove('animate-bounce');
            }, 1000);

            setTimeout(() => {
                toast.classList.add('hidden');
            }, duration);
        }

        function copyToClipboard(text, msg = 'Copiado para a área de transferência!') {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                triggerToast(msg);
            } catch (err) {
                console.error('Falha ao copiar:', err);
            }
            document.body.removeChild(textarea);
        }

