<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prime Markets Bank & Crypto Pro</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        prime: {
                            bg: '#05070a',
                            surface: '#0B0E14',
                            card: '#12161F',
                            cardHover: '#1A202C',
                            accent: '#0ECB81',
                            accentHover: '#10D88B',
                            gold: '#F0B90B',
                            danger: '#F6465D',
                            border: 'rgba(255, 255, 255, 0.08)',
                            textMuted: '#848E9C'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif']
                    },
                    boxShadow: {
                        'glow-emerald': '0 0 25px -5px rgba(14, 203, 129, 0.3)',
                        'glow-card': '0 10px 30px -10px rgba(0, 0, 0, 0.7)'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #05070a;
            color: #f1f5f9;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Custom Scrollbar for Desktop */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0B0E14;
        }
        ::-webkit-scrollbar-thumb {
            background: #1A202C;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #0ECB81;
        }

        /* Glassmorphism Effect */
        .glass-panel {
            background: rgba(18, 22, 31, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Price Flashes */
        @keyframes flashGreen {
            0% { background-color: rgba(14, 203, 129, 0.25); }
            100% { background-color: transparent; }
        }
        @keyframes flashRed {
            0% { background-color: rgba(246, 70, 93, 0.25); }
            100% { background-color: transparent; }
        }
        .flash-up { animation: flashGreen 0.8s ease-out; }
        .flash-down { animation: flashRed 0.8s ease-out; }
        
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-6px); }
            40%, 80% { transform: translateX(6px); }
        }
        .shake-err { animation: shake 0.35s ease-in-out; }

        canvas {
            touch-action: none;
        }
    </style>
</head>
<body class="bg-[#05070a] text-gray-100 min-h-screen flex flex-col justify-between overflow-x-hidden">

    <!-- Contentor Principal Adaptativo: Mobile + Desktop App Layout -->
    <div class="w-full min-h-screen flex flex-col lg:flex-row max-w-[1600px] mx-auto relative bg-[#0B0E14] lg:shadow-2xl lg:border-x lg:border-gray-800/80">

        <!-- ==================== DESKTOP SIDEBAR NAVIGATION ==================== -->
        <aside class="hidden lg:flex flex-col w-72 bg-[#0B0E14] border-r border-gray-800/80 p-5 justify-between shrink-0 sticky top-0 h-screen z-30">
            <div class="space-y-6">
                <!-- Logo & Brand Header -->
                <div class="flex items-center justify-between pb-4 border-b border-gray-800/80">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-700 flex items-center justify-center text-black font-black text-xl shadow-lg shadow-emerald-500/20">
                            P
                        </div>
                        <div>
                            <span class="text-base font-extrabold tracking-wider text-white block leading-none">PRIME</span>
                            <span class="text-[9px] font-bold text-emerald-400 tracking-[0.2em] uppercase">Private Banking</span>
                        </div>
                    </div>
                    <span class="text-[9px] bg-emerald-500/10 text-emerald-400 font-bold px-2 py-0.5 rounded-full border border-emerald-500/20">
                        PRO
                    </span>
                </div>

                <!-- Perfil Rápido do Utilizador Desktop -->
                <div class="p-3 bg-[#12161F] rounded-2xl border border-gray-800/80 flex items-center gap-3">
                    <div class="relative">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" 
                             alt="User Profile" 
                             class="w-10 h-10 rounded-xl object-cover border border-emerald-500/40"
                             onerror="this.src='https://placehold.co/100x100/12161F/0ECB81?text=PRO'">
                        <span class="absolute -bottom-1 -right-1 bg-emerald-500 text-black font-black text-[7px] px-1 rounded-full border border-[#0B0E14]">
                            VIP
                        </span>
                    </div>
                    <div class="overflow-hidden">
                        <div class="text-xs font-bold text-white truncate" id="dt-user-name">Alexandre V. Rocha</div>
                        <div class="text-[10px] text-emerald-400 font-medium truncate">Conta Verificada Pro</div>
                    </div>
                </div>

                <!-- Navegação Principal Desktop -->
                <nav class="space-y-1.5 text-xs font-semibold">
                    <button onclick="navSwitchTo('home')" id="nav-item-home" class="w-full flex items-center gap-3 px-3.5 py-3 rounded-2xl text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 font-bold transition">
                        <i class="fa-solid fa-house text-sm"></i>
                        <span>Visão Geral / Início</span>
                    </button>

                    <button onclick="navSwitchTo('markets')" id="nav-item-markets" class="w-full flex items-center gap-3 px-3.5 py-3 rounded-2xl text-gray-400 hover:text-white hover:bg-[#12161F] transition">
                        <i class="fa-solid fa-chart-line text-sm"></i>
                        <span>Terminal Trading & Mercados</span>
                    </button>

                    <button onclick="navSwitchTo('movements')" id="nav-item-movements" class="w-full flex items-center gap-3 px-3.5 py-3 rounded-2xl text-gray-400 hover:text-white hover:bg-[#12161F] transition">
                        <i class="fa-solid fa-clock-rotate-left text-sm"></i>
                        <span>Extrato & Movimentos</span>
                    </button>

                    <button onclick="showIBANModal()" class="w-full flex items-center gap-3 px-3.5 py-3 rounded-2xl text-gray-400 hover:text-white hover:bg-[#12161F] transition">
                        <i class="fa-solid fa-credit-card text-sm"></i>
                        <span>Dados da Conta / IBAN</span>
                    </button>
                </nav>

                <!-- Atalhos de Depósito e Transferência -->
                <div class="pt-4 border-t border-gray-800/80 space-y-2">
                    <button onclick="showDepositModal()" class="w-full bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold py-2.5 rounded-xl text-xs transition shadow flex items-center justify-center gap-2">
                        <i class="fa-solid fa-circle-arrow-down"></i>
                        <span>Depositar Fundos</span>
                    </button>
                    <button onclick="showTransferModal()" class="w-full bg-[#12161F] hover:bg-[#1A202C] text-gray-200 font-bold py-2.5 rounded-xl text-xs border border-gray-800 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-paper-plane text-emerald-400"></i>
                        <span>Transferir</span>
                    </button>
                </div>
            </div>

            <!-- Rodapé Sidebar -->
            <div class="pt-4 border-t border-gray-800/80 text-[10px] text-gray-500 flex items-center justify-between">
                <span><i class="fa-solid fa-shield-halved text-emerald-400 mr-1"></i> SSL 256-Bit</span>
                <span>v4.2 Pro</span>
            </div>
        </aside>

        <!-- ==================== TELA DE LOGIN OVERLAY ==================== -->
        <div id="login-screen" class="fixed inset-0 z-50 bg-[#0B0E14] flex items-center justify-center p-4 overflow-y-auto transition-all duration-500">
            <div class="w-full max-w-md bg-[#12161F] border border-gray-800 rounded-3xl p-6 lg:p-8 shadow-2xl relative">
                
                <!-- Topbar do Login -->
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-700 flex items-center justify-center text-black font-black text-xl shadow-lg shadow-emerald-500/20">
                            P
                        </div>
                        <div>
                            <span class="text-lg font-extrabold tracking-wider text-white block leading-none">PRIME</span>
                            <span class="text-[9px] font-bold text-emerald-400 tracking-[0.2em] uppercase">Private Bank</span>
                        </div>
                    </div>
                    <span class="text-[10px] bg-emerald-500/10 text-emerald-400 font-bold px-2.5 py-1 rounded-full border border-emerald-500/20">
                        <i class="fa-solid fa-shield-halved mr-1"></i> Encriptado
                    </span>
                </div>

                <div class="mb-6">
                    <h1 class="text-xl lg:text-2xl font-black text-white mb-1 tracking-tight">Portal Financeiro Seguro</h1>
                    <p class="text-xs text-gray-400">Aceda à sua conta de investimentos e homebanking com total proteção.</p>
                </div>

                <!-- Alerta de Erro / Informação -->
                <div id="login-error" class="hidden mb-5 p-3.5 bg-red-950/60 border border-red-500/40 rounded-2xl flex items-center gap-3 text-red-400 text-xs shadow-lg">
                    <i class="fa-solid fa-circle-exclamation text-base text-red-500 shrink-0"></i>
                    <div>
                        <span class="font-bold block text-white">Aviso de Acesso</span>
                        <span id="login-error-text" class="text-[11px] text-gray-300">Utilizador ou credenciais incorretas. Tente novamente.</span>
                    </div>
                </div>

                <!-- Formulário de Login Bank Pro -->
                <form id="login-form" class="space-y-4" onsubmit="handleLogin(event)">
                    <div>
                        <label class="block text-xs font-semibold text-gray-400 mb-1.5 uppercase tracking-wider">Identificador / E-mail</label>
                        <div class="relative">
                            <span class="absolute left-4 top-3.5 text-gray-500"><i class="fa-regular fa-envelope"></i></span>
                            <input 
                                type="text" 
                                id="login-email" 
                                value="alexandre.rocha@primebank.com"
                                placeholder="exemplo@primebank.com" 
                                required
                                class="w-full pl-11 pr-4 py-3.5 text-sm bg-[#0B0E14] border border-gray-800 rounded-2xl text-white placeholder-gray-600 focus:outline-none focus:border-emerald-500 transition shadow-inner"
                            >
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-400 mb-1.5 uppercase tracking-wider">Palavra-passe</label>
                        <div class="relative">
                            <span class="absolute left-4 top-3.5 text-gray-500"><i class="fa-solid fa-lock"></i></span>
                            <input 
                                type="password" 
                                id="login-password" 
                                value="password123"
                                placeholder="••••••••••••" 
                                required
                                class="w-full pl-11 pr-11 py-3.5 text-sm bg-[#0B0E14] border border-gray-800 rounded-2xl text-white placeholder-gray-600 focus:outline-none focus:border-emerald-500 transition shadow-inner"
                            >
                            <button type="button" onclick="togglePasswordVisibility()" class="absolute right-4 top-3.5 text-gray-500 hover:text-white transition">
                                <i class="fa-regular fa-eye" id="password-toggle-icon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs gap-2 pt-1">
                        <label class="flex items-center gap-2 cursor-pointer text-gray-400 hover:text-gray-200">
                            <input type="checkbox" checked class="rounded bg-gray-900 border-gray-700 text-emerald-500 focus:ring-0">
                            <span>Lembrar sessão segura</span>
                        </label>
                        <button type="button" onclick="handleAccountRecoveryBypass()" class="text-emerald-400 font-semibold cursor-pointer hover:underline text-left sm:text-right">
                            Recuperar Acesso Sem Bloqueio
                        </button>
                    </div>

                    <button 
                        type="submit" 
                        id="btn-login"
                        class="w-full bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 active:scale-[0.98] text-black font-extrabold py-3.5 rounded-2xl text-sm transition shadow-lg shadow-emerald-500/25 mt-6 flex items-center justify-center gap-2">
                        <span id="btn-login-text">Entrar no Banco Pro</span>
                        <i class="fa-solid fa-shield-halved text-xs"></i>
                    </button>
                </form>

                <!-- Biometric Shortcut -->
                <div class="mt-6 text-center">
                    <button type="button" onclick="handleBiometricLogin()" class="p-3 bg-[#0B0E14] hover:bg-[#1A202C] border border-gray-800 rounded-2xl text-emerald-400 text-xs font-semibold inline-flex items-center gap-2 transition w-full justify-center">
                        <i class="fa-solid fa-fingerprint text-xl"></i>
                        <span>Entrar com Face ID / Biometria Instantânea</span>
                    </button>
                </div>

                <!-- Rodapé Login -->
                <div class="text-center text-[10px] text-gray-500 pt-4 mt-6 border-t border-gray-800/60 flex items-center justify-between">
                    <span>Prime Markets License #841/EU</span>
                    <span>v4.2 Pro Banking (Desbloqueado)</span>
                </div>
            </div>
        </div>

        <!-- ==================== ÁREA DE CONTEÚDO PRINCIPAL (DASHBOARD) ==================== -->
        <main class="flex-1 min-h-screen flex flex-col justify-between overflow-x-hidden relative">

            <!-- ==================== TELA DE HISTÓRICO E MOVIMENTOS ==================== -->
            <div id="movements-screen" class="hidden absolute inset-0 z-40 bg-[#0B0E14] flex flex-col justify-start overflow-y-auto transition-all duration-300">
                <!-- Header do Histórico -->
                <div class="p-4 lg:p-6 bg-[#12161F] border-b border-gray-800/80 flex items-center justify-between sticky top-0 z-10">
                    <div class="flex items-center gap-3">
                        <button onclick="closeMovementsScreen()" class="w-9 h-9 rounded-full bg-[#1A202C] flex items-center justify-center text-gray-300 hover:text-white transition border border-gray-700/50">
                            <i class="fa-solid fa-chevron-left text-sm"></i>
                        </button>
                        <div>
                            <h2 class="text-base lg:text-lg font-extrabold text-white leading-tight">Extrato & Movimentos</h2>
                            <p class="text-[10px] lg:text-xs text-gray-400">Histórico de transferências e investimentos em tempo real</p>
                        </div>
                    </div>
                    <button onclick="refreshMovementsList()" class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center text-emerald-400 hover:bg-emerald-500/20 transition">
                        <i class="fa-solid fa-arrows-rotate text-xs"></i>
                    </button>
                </div>

                <div class="p-4 lg:p-8 space-y-5 max-w-5xl mx-auto w-full">
                    <!-- Resumo Geral de Entradas vs Saídas -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="bg-[#12161F] p-4 lg:p-5 rounded-2xl border border-emerald-500/20 flex flex-col justify-between shadow-lg">
                            <div class="flex items-center gap-2 text-emerald-400 text-xs font-semibold mb-1">
                                <div class="w-7 h-7 rounded-lg bg-emerald-500/20 flex items-center justify-center">
                                    <i class="fa-solid fa-arrow-down-left text-xs"></i>
                                </div>
                                <span>Entradas Totais</span>
                            </div>
                            <span id="total-entradas" class="text-xl lg:text-2xl font-black text-white font-mono">+ €0,00</span>
                        </div>

                        <div class="bg-[#12161F] p-4 lg:p-5 rounded-2xl border border-red-500/20 flex flex-col justify-between shadow-lg">
                            <div class="flex items-center gap-2 text-red-400 text-xs font-semibold mb-1">
                                <div class="w-7 h-7 rounded-lg bg-red-500/20 flex items-center justify-center">
                                    <i class="fa-solid fa-arrow-up-right text-xs"></i>
                                </div>
                                <span>Saídas Totais</span>
                            </div>
                            <span id="total-saidas" class="text-xl lg:text-2xl font-black text-white font-mono">- €0,00</span>
                        </div>
                    </div>

                    <!-- Filtros de Seleção (Abas) -->
                    <div class="flex items-center bg-[#12161F] p-1.5 rounded-2xl border border-gray-800 text-xs font-semibold max-w-md">
                        <button onclick="filterMovements('todos')" id="tab-todos" class="flex-1 py-2.5 rounded-xl text-center bg-emerald-500 text-black font-extrabold transition shadow">
                            Todos
                        </button>
                        <button onclick="filterMovements('entrada')" id="tab-entrada" class="flex-1 py-2.5 rounded-xl text-center text-gray-400 hover:text-white transition">
                            Entradas
                        </button>
                        <button onclick="filterMovements('saida')" id="tab-saida" class="flex-1 py-2.5 rounded-xl text-center text-gray-400 hover:text-white transition">
                            Saídas
                        </button>
                    </div>

                    <!-- Lista de Movimentos Dynamic -->
                    <div id="movements-list" class="space-y-3">
                        <!-- Preenchido via JavaScript -->
                    </div>
                </div>
            </div>

            <!-- ==================== TELA DE MERCADOS & TRADING PRO ==================== -->
            <div id="markets-screen" class="hidden absolute inset-0 z-40 bg-[#0B0E14] flex flex-col justify-start overflow-y-auto transition-all duration-300">
                
                <!-- Header dos Mercados -->
                <div class="px-4 py-3 lg:px-6 lg:py-4 bg-[#12161F] border-b border-gray-800 flex items-center justify-between sticky top-0 z-20">
                    <div class="flex items-center gap-3">
                        <button onclick="closeMarketsScreen()" class="w-8 h-8 rounded-full bg-[#1A202C] flex items-center justify-center text-gray-300 hover:text-white transition border border-gray-700/50">
                            <i class="fa-solid fa-chevron-left text-xs"></i>
                        </button>
                        <div>
                            <h2 class="text-sm lg:text-base font-black text-white leading-none">Terminal Trading Pro</h2>
                            <span class="text-[9px] lg:text-[10px] text-emerald-400 font-bold">Gráficos & Cotações ao Vivo em Tempo Real</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] lg:text-xs font-mono font-bold text-gray-300 bg-[#1A202C] px-3 py-1.5 rounded-xl border border-gray-800">
                            Saldo: <strong class="text-emerald-400" id="trading-balance-display">€1.000.000,00</strong>
                        </span>
                    </div>
                </div>

                <!-- Conteúdo Principal dos Mercados (Responsivo para PC e Telemóvel) -->
                <div class="flex-1 p-3 lg:p-6 space-y-4 max-w-7xl mx-auto w-full">
                    
                    <!-- Abas Superiores de Categorias de Ativos -->
                    <div class="flex items-center bg-[#12161F] p-1.5 rounded-2xl border border-gray-800 text-xs font-bold max-w-lg">
                        <button onclick="switchMarketCategory('crypto')" id="cat-btn-crypto" class="flex-1 py-2 rounded-xl text-center bg-emerald-500 text-black transition shadow">
                            <i class="fa-brands fa-bitcoin mr-1"></i> Cripto
                        </button>
                        <button onclick="switchMarketCategory('commodities')" id="cat-btn-commodities" class="flex-1 py-2 rounded-xl text-center text-gray-400 hover:text-white transition">
                            <i class="fa-solid fa-cubes-stacked mr-1"></i> Commodities
                        </button>
                        <button onclick="switchMarketCategory('forex')" id="cat-btn-forex" class="flex-1 py-2 rounded-xl text-center text-gray-400 hover:text-white transition">
                            <i class="fa-solid fa-money-bill-transfer mr-1"></i> Moedas
                        </button>
                    </div>

                    <!-- Seletor Horizontal de Ativos em Destaque -->
                    <div id="asset-selector-bar" class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
                        <!-- Preenchido via JS conforme a categoria -->
                    </div>

                    <!-- Layout em Grelha Desktop (Gráfico à Esquerda, Ordens à Direita) -->
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6">
                        
                        <!-- Coluna do Gráfico e Detalhes do Ativo -->
                        <div class="lg:col-span-8 space-y-4">
                            <!-- Card Principal do Ativo e Gráfico -->
                            <div class="bg-[#12161F] rounded-3xl border border-gray-800 p-4 lg:p-6 space-y-4 shadow-lg">
                                <!-- Informações Principais do Ativo Selecionado -->
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                    <div class="flex items-center gap-3">
                                        <div id="selected-asset-icon" class="w-12 h-12 rounded-2xl bg-orange-500/10 border border-orange-500/20 text-orange-400 flex items-center justify-center font-bold text-xl shrink-0">
                                            <i class="fa-brands fa-bitcoin"></i>
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <h3 id="selected-asset-name" class="text-base lg:text-lg font-black text-white">Bitcoin / Euro</h3>
                                                <span id="selected-asset-symbol" class="text-[10px] bg-gray-800 text-gray-300 px-2 py-0.5 rounded font-mono font-bold">BTC/EUR</span>
                                            </div>
                                            <div class="text-[11px] text-gray-400 flex items-center gap-2 mt-0.5">
                                                <span>24h Máx: <strong class="text-gray-200" id="asset-24h-high">82.100,00</strong></span>
                                                <span>●</span>
                                                <span>24h Mín: <strong class="text-gray-200" id="asset-24h-low">79.800,00</strong></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="text-left sm:text-right">
                                        <div id="selected-asset-price" class="text-xl lg:text-2xl font-black text-white font-mono leading-tight">81.416,00 €</div>
                                        <span id="selected-asset-change" class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-md inline-block mt-1">+2.45%</span>
                                    </div>
                                </div>

                                <!-- Controlos do Gráfico (Timeframe + Tipo de Gráfico) -->
                                <div class="flex flex-wrap items-center justify-between border-t border-b border-gray-800/80 py-2 gap-2 text-xs font-bold">
                                    <!-- Timeframes -->
                                    <div class="flex items-center gap-1.5 text-gray-400">
                                        <button onclick="setTimeframe('1M')" class="tf-btn px-2.5 py-1 rounded-lg hover:text-white transition">1M</button>
                                        <button onclick="setTimeframe('5M')" class="tf-btn px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">5M</button>
                                        <button onclick="setTimeframe('15M')" class="tf-btn px-2.5 py-1 rounded-lg hover:text-white transition">15M</button>
                                        <button onclick="setTimeframe('1H')" class="tf-btn px-2.5 py-1 rounded-lg hover:text-white transition">1H</button>
                                        <button onclick="setTimeframe('1D')" class="tf-btn px-2.5 py-1 rounded-lg hover:text-white transition">1D</button>
                                    </div>

