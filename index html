            e.preventDefault();
            closeDepositModal();
            triggerToast("Depósito com cartão processado com sucesso!");
        }

        function handleMBWayDeposit(e) {
            e.preventDefault();
            closeDepositModal();
            triggerToast("Pedido MB WAY enviado para o seu telemóvel!");
        }

        function handleTransferSubmit(e) {
            e.preventDefault();
            const amount = parseFloat(document.getElementById('trans-amount').value) || 0;
            const dest = document.getElementById('trans-dest').value;

            if (amount <= 0 || amount > AppState.balance) {
                triggerToast("Saldo insuficiente ou valor inválido.");
                return;
            }

            AppState.balance -= amount;
            updateBalanceUI();

            AppState.movements.unshift({
                id: Date.now(),
                type: 'saida',
                title: `Transferência enviada para ${dest}`,
                desc: 'Transferência SEPA Instantânea',
                amount: amount,
                date: new Date().toISOString().replace('T', ' ').substring(0, 16),
                status: 'Concluído'
            });

            closeTransferModal();
            triggerToast(`Transferência de €${formatCurrency(amount)} realizada!`);
            renderMovementsList('todos');
        }

        // --- NAVEGAÇÃO DE ECRÃS ---
        function openMovementsScreen() {
            document.getElementById('movements-screen').classList.remove('hidden');
            renderMovementsList('todos');
        }

        function closeMovementsScreen() {
            document.getElementById('movements-screen').classList.add('hidden');
        }

        function openMarketsScreen() {
            document.getElementById('markets-screen').classList.remove('hidden');
            setTimeout(resizeAndDrawChart, 150);
        }

        function closeMarketsScreen() {
            document.getElementById('markets-screen').classList.add('hidden');
        }

        function openTradingForAsset(category, assetId) {
            switchMarketCategory(category);
            selectAsset(assetId);
            openMarketsScreen();
        }

        // --- MOVIMENTOS / EXTRATO ---
        function updateMovementsTotals() {
            const totalEntradas = AppState.movements
                .filter(m => m.type === 'entrada')
                .reduce((acc, m) => acc + m.amount, 0);
            const totalSaidas = AppState.movements
                .filter(m => m.type === 'saida')
                .reduce((acc, m) => acc + m.amount, 0);

            const elEntradas = document.getElementById('total-entradas');
            const elSaidas = document.getElementById('total-saidas');
            if (elEntradas) elEntradas.innerText = `+ €${formatCurrency(totalEntradas)}`;
            if (elSaidas) elSaidas.innerText = `- €${formatCurrency(totalSaidas)}`;
        }

        function renderMovementsList(filter) {
            updateMovementsTotals();
            const container = document.getElementById('movements-list');
            if (!container) return;

            container.innerHTML = '';
            const filtered = AppState.movements.filter(m => filter === 'todos' || m.type === filter);

            if (filtered.length === 0) {
                container.innerHTML = `<div class="text-center py-12 text-gray-500 text-xs font-semibold">Sem movimentos registados nesta categoria.</div>`;
                return;
            }

            filtered.forEach(m => {
                const isEntrada = m.type === 'entrada';
                const colorClass = isEntrada ? 'text-emerald-400' : 'text-red-400';
                const sign = isEntrada ? '+' : '-';
                const icon = isEntrada ? 'fa-arrow-down-left' : 'fa-arrow-up-right';
                const bgIcon = isEntrada ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' : 'bg-red-500/10 text-red-400 border-red-500/20';

                const html = `
                    <div class="bg-[#12161F] p-4 rounded-2xl border border-gray-800 flex items-center justify-between hover:border-gray-700 transition">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl ${bgIcon} border flex items-center justify-center text-sm shrink-0">
                                <i class="fa-solid ${icon}"></i>
                            </div>
                            <div>
                                <h4 class="text-xs lg:text-sm font-bold text-white leading-tight">${m.title}</h4>
                                <p class="text-[10px] lg:text-xs text-gray-400">${m.desc} • ${m.date}</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-xs lg:text-sm font-black font-mono ${colorClass}">${sign} €${formatCurrency(m.amount)}</span>
                            <span class="block text-[9px] lg:text-[10px] text-emerald-400 font-semibold">${m.status}</span>
                        </div>
                    </div>
                `;
                container.innerHTML += html;
            });
        }

        function filterMovements(type) {
            ['todos', 'entrada', 'saida'].forEach(t => {
                const btn = document.getElementById(`tab-${t}`);
                if (btn) {
                    if (t === type) {
                        btn.className = 'flex-1 py-2.5 rounded-xl text-center bg-emerald-500 text-black font-extrabold transition shadow';
                    } else {
                        btn.className = 'flex-1 py-2.5 rounded-xl text-center text-gray-400 hover:text-white transition';
                    }
                }
            });
            renderMovementsList(type);
        }

        function refreshMovementsList() {
            triggerToast("Extrato e saldo sincronizados em tempo real!");
            renderMovementsList('todos');
        }

        // --- TERMINAL DE TRADING & MERCADOS ---
        function switchMarketCategory(category) {
            AppState.activeCategory = category;
            
            ['crypto', 'commodities', 'forex'].forEach(cat => {
                const btn = document.getElementById(`cat-btn-${cat}`);
                if (btn) {
                    if (cat === category) {
                        btn.className = 'flex-1 py-2 rounded-xl text-center bg-emerald-500 text-black font-black transition shadow';
                    } else {
                        btn.className = 'flex-1 py-2 rounded-xl text-center text-gray-400 hover:text-white transition';
                    }
                }
            });

            renderAssetSelectorBar();
            const firstAsset = AssetsData[category][0].id;
            selectAsset(firstAsset);
        }

        function renderAssetSelectorBar() {
            const bar = document.getElementById('asset-selector-bar');
            if (!bar) return;

            bar.innerHTML = '';
            const list = AssetsData[AppState.activeCategory] || [];

            list.forEach(asset => {
                const isSelected = asset.id === AppState.selectedAsset;
                const activeClass = isSelected ? 'bg-[#1A202C] border-emerald-500 text-white shadow' : 'bg-[#12161F] border-gray-800 text-gray-400 hover:text-white';
                
                const btn = document.createElement('button');
                btn.className = `flex items-center gap-2 px-3.5 py-2 rounded-xl border text-xs font-bold transition shrink-0 ${activeClass}`;
                btn.onclick = () => selectAsset(asset.id);
                btn.innerHTML = `
                    <i class="${asset.icon} ${asset.iconColor}"></i>
                    <span>${asset.symbol}</span>
                `;
                bar.appendChild(btn);
            });
        }

        function selectAsset(assetId) {
            AppState.selectedAsset = assetId;
            const list = AssetsData[AppState.activeCategory] || [];
            const asset = list.find(a => a.id === assetId) || list[0];

            if (!asset) return;

            document.getElementById('selected-asset-name').innerText = asset.name;
            document.getElementById('selected-asset-symbol').innerText = asset.symbol;
            document.getElementById('selected-asset-price').innerText = asset.symbol.includes('USD') ? `${formatCurrency(asset.price)} $` : `${formatCurrency(asset.price)} €`;
            document.getElementById('selected-asset-change').innerText = `${asset.change >= 0 ? '+' : ''}${asset.change}%`;
            document.getElementById('asset-24h-high').innerText = asset.high;
            document.getElementById('asset-24h-low').innerText = asset.low;

            const iconContainer = document.getElementById('selected-asset-icon');
            iconContainer.className = `w-12 h-12 rounded-2xl ${asset.bgIcon} border flex items-center justify-center font-bold text-xl shrink-0 ${asset.iconColor}`;
            iconContainer.innerHTML = `<i class="${asset.icon}"></i>`;

            const btnText = document.getElementById('btn-trade-action-text');
            if (btnText) {
                const action = AppState.tradeSide === 'buy' ? 'COMPRAR' : 'VENDER';
                btnText.innerText = `EXECUTAR ${action} DE ${asset.symbol.split('/')[0]}`;
            }

            renderAssetSelectorBar();
            calculateTradeUnits();
            resizeAndDrawChart();
        }

        function setTradeSide(side) {
            AppState.tradeSide = side;
            const buyBtn = document.getElementById('btn-side-buy');
            const sellBtn = document.getElementById('btn-side-sell');
            const executeBtn = document.getElementById('btn-execute-trade');

            if (side === 'buy') {
                buyBtn.className = 'py-3 rounded-xl bg-emerald-500 text-black transition shadow flex items-center justify-center gap-1.5';
                sellBtn.className = 'py-3 rounded-xl text-gray-400 hover:text-white transition flex items-center justify-center gap-1.5';
                executeBtn.className = 'w-full bg-emerald-500 hover:bg-emerald-400 active:scale-[0.98] text-black font-extrabold py-4 rounded-2xl text-xs lg:text-sm transition shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2';
            } else {
                sellBtn.className = 'py-3 rounded-xl bg-red-500 text-white transition shadow flex items-center justify-center gap-1.5';
                buyBtn.className = 'py-3 rounded-xl text-gray-400 hover:text-white transition flex items-center justify-center gap-1.5';
                executeBtn.className = 'w-full bg-red-500 hover:bg-red-400 active:scale-[0.98] text-white font-extrabold py-4 rounded-2xl text-xs lg:text-sm transition shadow-lg shadow-red-500/20 flex items-center justify-center gap-2';
            }

            const list = AssetsData[AppState.activeCategory] || [];
            const asset = list.find(a => a.id === AppState.selectedAsset) || list[0];
            const actionText = side === 'buy' ? 'COMPRAR' : 'VENDER';
            document.getElementById('btn-trade-action-text').innerText = `EXECUTAR ${actionText} DE ${asset.symbol.split('/')[0]}`;
        }

        function setTimeframe(tf) {
            AppState.timeframe = tf;
            document.querySelectorAll('.tf-btn').forEach(btn => {
                if (btn.innerText === tf) {
                    btn.className = 'tf-btn px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
                } else {
                    btn.className = 'tf-btn px-2.5 py-1 rounded-lg hover:text-white transition';
                }
            });
            resizeAndDrawChart();
        }

        function setChartType(type) {
            AppState.chartType = type;
            const candleBtn = document.getElementById('chart-type-candles');
            const lineBtn = document.getElementById('chart-type-line');

            if (type === 'candles') {
                candleBtn.className = 'px-2.5 py-1 rounded-lg bg-emerald-500 text-black font-extrabold transition text-xs';
                lineBtn.className = 'px-2.5 py-1 rounded-lg text-gray-400 hover:text-white transition text-xs';
            } else {
                lineBtn.className = 'px-2.5 py-1 rounded-lg bg-emerald-500 text-black font-extrabold transition text-xs';
                candleBtn.className = 'px-2.5 py-1 rounded-lg text-gray-400 hover:text-white transition text-xs';
            }
            resizeAndDrawChart();
        }

        function setTradeAmountPercent(pct) {
            const amount = (AppState.balance * (pct / 100)).toFixed(2);
            document.getElementById('trade-amount-input').value = amount;
            calculateTradeUnits();
        }

        function calculateTradeUnits() {
            const inputVal = parseFloat(document.getElementById('trade-amount-input').value) || 0;
            const leverage = parseInt(document.getElementById('order-leverage-select').value) || 1;
            
            const list = AssetsData[AppState.activeCategory] || [];
            const asset = list.find(a => a.id === AppState.selectedAsset) || list[0];

            const totalPosition = inputVal * leverage;
            const units = asset ? (totalPosition / asset.price).toFixed(4) : '0.0000';

            document.getElementById('calc-position-size').innerText = `€${formatCurrency(totalPosition)}`;
            document.getElementById('calc-asset-units').innerText = `${units} ${asset.symbol.split('/')[0]}`;
        }

        // --- EXECUÇÃO DE ORDENS E POSIÇÕES ---
        function executeTradeOrder() {
            const amount = parseFloat(document.getElementById('trade-amount-input').value);
            if (!amount || amount <= 0) {
                triggerToast('Introduza um valor válido para a ordem.');
                return;
            }

            if (amount > AppState.balance) {
                triggerToast('Saldo insuficiente para esta margem.');
                return;
            }

            const leverage = parseInt(document.getElementById('order-leverage-select').value) || 1;
            const list = AssetsData[AppState.activeCategory] || [];
            const asset = list.find(a => a.id === AppState.selectedAsset) || list[0];

            // Subtrair Margem do Saldo
            AppState.balance -= amount;
            updateBalanceUI();

            // Criar Posição
            const position = {
                id: Date.now(),
                asset: asset.symbol,
                side: AppState.tradeSide,
                entryPrice: asset.price,
                currentPrice: asset.price,
                amount: amount,
                leverage: leverage,
                pnl: 0
            };

            AppState.positions.push(position);
            
            // Registar no Extrato
            AppState.movements.unshift({
                id: Date.now(),
                type: 'saida',
                title: `Ordem ${AppState.tradeSide.toUpperCase()} ${asset.symbol}`,
                desc: `Alavancagem ${leverage}x • Posição Aberta`,
                amount: amount,
                date: new Date().toISOString().replace('T', ' ').substring(0, 16),
                status: 'Executado'
            });

            triggerToast(`Posição de ${asset.symbol} aberta com sucesso!`);
            renderPositions();
            document.getElementById('trade-amount-input').value = '';
            calculateTradeUnits();
        }

        function closePosition(positionId) {
            const index = AppState.positions.findIndex(p => p.id === positionId);
            if (index !== -1) {
                const pos = AppState.positions[index];
                const returnedAmount = pos.amount + pos.pnl;
                
                AppState.balance += Math.max(0, returnedAmount);
                updateBalanceUI();

                AppState.movements.unshift({
                    id: Date.now(),
                    type: pos.pnl >= 0 ? 'entrada' : 'saida',
                    title: `Fecho Posição ${pos.asset}`,
                    desc: `PnL Final: €${formatCurrency(pos.pnl)}`,
                    amount: Math.abs(pos.pnl),
                    date: new Date().toISOString().replace('T', ' ').substring(0, 16),
                    status: 'Concluído'
                });

                AppState.positions.splice(index, 1);
                triggerToast('Posição fechada com sucesso!');
                renderPositions();
            }
        }

        function renderPositions() {
            const container = document.getElementById('positions-container');
            const countLabel = document.getElementById('active-positions-count');

            if (!container) return;

            countLabel.innerText = `${AppState.positions.length} Posição(ões)`;

            if (AppState.positions.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-6 text-gray-500 text-xs">
                        <i class="fa-solid fa-chart-pie text-2xl mb-1.5 opacity-40"></i>
                        <p>Sem posições ativas no momento.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = '';
            AppState.positions.forEach(pos => {
                const isProfit = pos.pnl >= 0;
                const pnlClass = isProfit ? 'text-emerald-400' : 'text-red-400';
                const sideBg = pos.side === 'buy' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30' : 'bg-red-500/20 text-red-400 border-red-500/30';

                const html = `
                    <div class="bg-[#0B0E14] p-3.5 rounded-2xl border border-gray-800 flex items-center justify-between text-xs">
                        <div class="space-y-0.5">
                            <div class="flex items-center gap-2">
                                <span class="font-extrabold text-white text-sm">${pos.asset}</span>
                                <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase border ${sideBg}">${pos.side} ${pos.leverage}x</span>
                            </div>
                            <div class="text-[10px] text-gray-400 font-mono">
                                Entrada: ${formatCurrency(pos.entryPrice)} • Atual: ${formatCurrency(pos.currentPrice)}
                            </div>
                        </div>

                        <div class="text-right flex items-center gap-3">
                            <div>
                                <span class="text-[10px] text-gray-400 block">PnL Não Realizado</span>
                                <span class="font-mono font-black text-sm ${pnlClass}">${isProfit ? '+' : ''}€${formatCurrency(pos.pnl)}</span>
                            </div>
                            <button onclick="closePosition(${pos.id})" class="px-3 py-1.5 bg-red-500/20 hover:bg-red-500/30 text-red-400 font-bold rounded-xl border border-red-500/30 text-xs transition">
                                Fechar
                            </button>
                        </div>
                    </div>
                `;
                container.innerHTML += html;
            });
        }

        // --- SIMULAÇÃO DE COTAÇÕES AO VIVO ---
        function simulateMarketTicks() {
            Object.keys(AssetsData).forEach(cat => {
                AssetsData[cat].forEach(asset => {
                    const deltaPercent = (Math.random() - 0.49) * 0.004;
                    asset.price = Math.max(0.0001, asset.price * (1 + deltaPercent));
                    
                    if (asset.id === AppState.selectedAsset) {
                        const priceDisplay = document.getElementById('selected-asset-price');
                        if (priceDisplay) {
                            priceDisplay.innerText = asset.symbol.includes('USD') ? `${formatCurrency(asset.price)} $` : `${formatCurrency(asset.price)} €`;
                            priceDisplay.classList.add(deltaPercent >= 0 ? 'flash-up' : 'flash-down');
                            setTimeout(() => priceDisplay.classList.remove('flash-up', 'flash-down'), 800);
                        }
                    }

                    // Atualizar na lista principal se visível
                    const rowPrice = document.getElementById(`${asset.id}-price`);
                    if (rowPrice) {
                        rowPrice.innerText = asset.symbol.includes('USD') ? `${formatCurrency(asset.price)} $` : `${formatCurrency(asset.price)} €`;
                    }
                });
            });

            // Atualizar PnL das Posições Abertas
            AppState.positions.forEach(pos => {
                const list = [].concat(...Object.values(AssetsData));
                const asset = list.find(a => a.symbol === pos.asset);
                if (asset) {
                    pos.currentPrice = asset.price;
                    const diffPercent = (pos.currentPrice - pos.entryPrice) / pos.entryPrice;
                    const multiplier = pos.side === 'buy' ? 1 : -1;
                    pos.pnl = pos.amount * diffPercent * pos.leverage * multiplier;
                }
            });

            if (AppState.positions.length > 0) {
                renderPositions();
            }

            drawChart();
        }

        // --- ENGENHO DE DESENHO DE GRÁFICOS NO CANVAS RESPONSIÇÃO ---
        function resizeAndDrawChart() {
            if (!chartCanvas) return;
            const parent = chartCanvas.parentElement;
            if (!parent) return;

            chartCanvas.width = parent.clientWidth;
            chartCanvas.height = parent.clientHeight;
            drawChart();
        }

        function drawChart() {
            if (!chartCtx || !chartCanvas) return;

            const w = chartCanvas.width;
            const h = chartCanvas.height;
            chartCtx.clearRect(0, 0, w, h);

            if (w === 0 || h === 0) return;

            // Grelha de Fundo
            chartCtx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
            chartCtx.lineWidth = 1;

            const gridStepX = w > 600 ? 60 : 40;
            const gridStepY = h > 300 ? 40 : 30;

            for (let x = 0; x < w; x += gridStepX) {
                chartCtx.beginPath();
                chartCtx.moveTo(x, 0);
                chartCtx.lineTo(x, h);
                chartCtx.stroke();
            }

            for (let y = 0; y < h; y += gridStepY) {
                chartCtx.beginPath();
                chartCtx.moveTo(0, y);
                chartCtx.lineTo(w, y);
                chartCtx.stroke();
            }

            // Gerar Candlesticks / Linha
            const candlesCount = w > 600 ? 40 : 25;
            const candleWidth = w / candlesCount;

            let seedPrice = 100;
            const points = [];

            for (let i = 0; i < candlesCount; i++) {
                const open = seedPrice;
                const close = open + (Math.sin(i * 0.8) * 3) + ((Math.random() - 0.48) * 4);
                const high = Math.max(open, close) + Math.random() * 2;
                const low = Math.min(open, close) - Math.random() * 2;
                seedPrice = close;
                points.push({ open, close, high, low });
            }

            // Calcular escala Y
            let minP = Math.min(...points.map(p => p.low));
            let maxP = Math.max(...points.map(p => p.high));
            if (minP === maxP) { minP -= 1; maxP += 1; }

            const range = maxP - minP;
            const getY = (val) => h - 20 - ((val - minP) / range) * (h - 40);

            if (AppState.chartType === 'candles') {
                points.forEach((p, i) => {
                    const x = i * candleWidth + candleWidth / 2;
                    const isGreen = p.close >= p.open;
                    const color = isGreen ? '#0ECB81' : '#F6465D';

                    // Pavio / Mecha
                    chartCtx.strokeStyle = color;
                    chartCtx.lineWidth = 1.5;
                    chartCtx.beginPath();
                    chartCtx.moveTo(x, getY(p.high));
                    chartCtx.lineTo(x, getY(p.low));
                    chartCtx.stroke();

                    // Corpo da Vela
                    chartCtx.fillStyle = color;
                    const bodyTop = getY(Math.max(p.open, p.close));
                    const bodyBottom = getY(Math.min(p.open, p.close));
                    const bodyHeight = Math.max(2, bodyBottom - bodyTop);
                    const bw = Math.max(2, candleWidth * 0.6);
                    chartCtx.fillRect(x - bw / 2, bodyTop, bw, bodyHeight);
                });
            } else {
                // Desenhar gráfico de Linha
                chartCtx.strokeStyle = '#0ECB81';
                chartCtx.lineWidth = 2.5;
                chartCtx.beginPath();

                points.forEach((p, i) => {
                    const x = i * candleWidth + candleWidth / 2;
                    const y = getY(p.close);
                    if (i === 0) chartCtx.moveTo(x, y);
                    else chartCtx.lineTo(x, y);
                });
                chartCtx.stroke();

                // Preenchimento com gradiente suave
                const gradient = chartCtx.createLinearGradient(0, 0, 0, h);
                gradient.addColorStop(0, 'rgba(14, 203, 129, 0.25)');
                gradient.addColorStop(1, 'rgba(14, 203, 129, 0.0)');
                
                chartCtx.lineTo((points.length - 1) * candleWidth + candleWidth / 2, h);
                chartCtx.lineTo(candleWidth / 2, h);
                chartCtx.closePath();
                chartCtx.fillStyle = gradient;
                chartCtx.fill();
            }
        }

        // Redimensionar canvas dinamicamente
        window.addEventListener('resize', resizeAndDrawChart);
    </script>
